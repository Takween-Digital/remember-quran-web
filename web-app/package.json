{
  "name": "rememberquran.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "rm -rf .next/cache && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:pages": "pnpm install --no-frozen-lockfile && rm -rf .next/cache && next build && opennextjs-cloudflare build",
    "deploy:pages": "npm run build:pages",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute rememberquran-db --local --file=drizzle/0000_init.sql",
    "db:migrate:prod": "wrangler d1 execute rememberquran-db --file=drizzle/0000_init.sql",
    "firebase:emulators": "firebase emulators:start --only firestore,auth --project demo-rememberquran",
    "migrate:firebase-auth": "tsx scripts/migrate-users-to-firebase-auth.ts",
    "responsive-check": "node scripts/responsive-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "framer-motion": "^13.1.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "next-firebase-auth-edge": "^1.12.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.22.0",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^14.13.0",
    "playwright": "^1.63.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "terser": "^5.51.2",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wrangler": "^4.135.0"
  }
}
