{
  "name": "rememberquran.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev -p 3000 -H 0.0.0.0",
    "build": "vinext build",
    "start": "vinext start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "deploy:cf": "npx @vinext/cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute rememberquran-db --local --file=drizzle/0000_init.sql",
    "db:migrate:prod": "wrangler d1 execute rememberquran-db --file=drizzle/0000_init.sql",
    "firebase:emulators": "firebase emulators:start --only firestore,auth --project demo-rememberquran",
    "migrate:firebase-auth": "tsx scripts/migrate-users-to-firebase-auth.ts",
    "responsive-check": "node scripts/responsive-check.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build && node scripts/generate-cloudflare-handler.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "npm run build:vinext && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "framer-motion": "^13.1.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "next-firebase-auth-edge": "^1.12.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "resend": "^6.22.0",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.0-beta.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vinext/cloudflare": "^1.0.0-beta.10",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^14.13.0",
    "playwright": "^1.63.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
