{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rememberquran",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rememberquran-db",
      "database_id": "2a4a38a9-de4e-432c-bb90-5a419bb6c82a"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "7be8fb49d877416eb6a27a2675ff8450"
    },
    {
      "binding": "AUDIO_CACHE_KV",
      "id": "7be8fb49d877416eb6a27a2675ff8450"
    }
  ],
  "routes": [
    { "pattern": "rememberquran.com", "custom_domain": true },
    { "pattern": "www.rememberquran.com", "custom_domain": true }
  ],
  "workers_dev": true
}
